{
  "name": "cityu-universal-sinno",
  "displayName": "CityU Universal Sinno",
  "version": "0.1.3",
  "description": "Privacy-first Digital Adoption Platform for CityU AIMS",
  "author": "CityU Universal Sinno",
  "manifest": {
    "manifest_version": 3,
    "name": "CityU Universal Sinno",
    "version": "0.1.3",
    "description": "Privacy-first Digital Adoption Platform for CityU AIMS",
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    "host_permissions": [
      "https://*.cityu.edu.hk/*",
      "https://*.workers.dev/*"
    ],
    "action": {
      "default_title": "CityU Universal Sinno"
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "start": "plasmo start",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "plasmo": "^0.89.2",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
}
